server {
    listen 80;
    server_name _;

    root /opt/crm-frontend;
    index index.html;

    location /api/clients {
        proxy_pass http://;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/logs {
        proxy_pass http:;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
